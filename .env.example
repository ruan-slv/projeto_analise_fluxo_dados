# ============================================================================
#  Configuração de conexão — ETL AdventureWorks -> DW
#  Copie para `.env` e ajuste os valores ao seu ambiente.
#
#  AW_DSN : fonte OLTP  (AdventureWorks 2016)
#  DW_DSN : destino DW  (banco do Data Warehouse)
#
#  Exemplo (servidor local, porta 5433, auth trust):
#    AW_DSN=host=127.0.0.1 port=5433 user=postgres dbname=adventureworks
#    DW_DSN=host=127.0.0.1 port=5433 user=postgres dbname=dw_adventureworks
#
#  Exemplo (Docker, padrão do enunciado):
#    AW_DSN=host=localhost port=5432 user=postgres password=senha dbname=adventureworks
#    DW_DSN=host=localhost port=5432 user=postgres password=senha dbname=olap_etl
# ============================================================================
AW_DSN=host=127.0.0.1 port=5433 user=postgres dbname=adventureworks
DW_DSN=host=127.0.0.1 port=5433 user=postgres dbname=dw_adventureworks
